{
  "buildCommand": "sed -i 's/GMAPS_KEY_PLACEHOLDER/'\"$VITE_GOOGLE_MAPS_API_KEY\"'/g' index.html",
  "outputDirectory": ".",
  "headers": [
    {
      "source": "/(.*\\.html)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Pragma", "value": "no-cache" }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    }
  ]
}

